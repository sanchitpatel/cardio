{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gyno",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SUPABASE_URL": "https://kbydsthwpgjaiyjguzfd.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_idPNdZpR75bUZZSG8sT58g_d8oDky7b",
    "PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_idPNdZpR75bUZZSG8sT58g_d8oDky7b"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
