---
import "../styles/dashboard.css";
import siteData from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  showFloatingContact?: boolean;
}

const {
  title = `${siteData.name} — ${siteData.tagline}`,
  description = "Specialized cardiovascular care, coronary artery disease, heart failure management, arrhythmia evaluation, and digital cardiac clinical records.",
  showFloatingContact = false,
} = Astro.props;

const whatsappUrl = `https://wa.me/${siteData.whatsappPhone || '918006460900'}?text=${encodeURIComponent(siteData.whatsappMessage || 'Hello dHealth Cardio, I would like to inquire about a cardiology consultation.')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/avif" sizes="any" href="/logo.avif" />
    <link rel="icon" type="image/avif" sizes="512x512" href="/logo.avif" />
    <link rel="icon" type="image/avif" sizes="192x192" href="/logo.avif" />
    <link rel="shortcut icon" href="/logo.avif" />
    <link rel="apple-touch-icon" href="/logo.avif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO & Clinical Meta Tags -->
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- PWA & Mobile Web App Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#e6ebf2" />
    <meta name="msapplication-navbutton-color" content="#e6ebf2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cardio Console" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.avif" />

    <!-- Google Fonts: Plus Jakarta Sans, Sora & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Sora:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- PWA Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function(err) {
            console.warn('PWA registration skipped:', err);
          });
        });
      }
    </script>
  </head>
  <body class="bg-[#e6ebf2] text-zinc-900 antialiased selection:bg-emerald-500/20 selection:text-emerald-900 min-h-screen">
    <slot />

    <!-- Optional Floating WhatsApp Cardiac Desk Contact Button -->
    {showFloatingContact && (
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Direct WhatsApp Cardiac Care Consultation"
        class="fixed bottom-6 right-6 z-50 flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-[#e6ebf2] text-emerald-700 shadow-[4px_4px_10px_#c2c9d4,-4px_-4px_10px_#ffffff] border border-white/80 transition-all duration-300 hover:scale-105 active:scale-95 group"
      >
        <svg class="h-6 w-6 sm:h-7 sm:w-7 fill-current text-[#25D366]" viewBox="0 0 256 256">
          <path d="M128,24A104,104,0,0,0,36.8,179.8L24.6,222.8a12,12,0,0,0,14.6,14.6l43-12.2A104,104,0,1,0,128,24Zm0,192a87.6,87.6,0,0,1-44.9-12.3,6,6,0,0,0-4.7-.6l-34.9,9.9,9.9-34.9a6,6,0,0,0-.6-4.7A88,88,0,1,1,128,216Zm51.3-64.7-20-10a14.1,14.1,0,0,0-15.7,2.8l-7.7,7.8a4,4,0,0,1-4.3,1,72.6,72.6,0,0,1-30.7-30.7,4,4,0,0,1,1-4.3l7.8-7.7a14.1,14.1,0,0,0,2.8-15.7l-10-20a14,14,0,0,0-19.4-6.4l-11.3,5.6a14.1,14.1,0,0,0-7.8,12.5,90.4,90.4,0,0,0,76.6,76.6,14.1,14.1,0,0,0,12.5-7.8l5.6-11.3A14,14,0,0,0,179.3,151.3Z"/>
        </svg>
      </a>
    )}
  </body>
</html>
