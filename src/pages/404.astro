---
import "../styles/dashboard.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — Page Not Found | Cardio Console</title>
    <link rel="icon" type="image/png" href="/logo.avif" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#d9e2ec]/30 text-zinc-900 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-[#e6ebf2] rounded-3xl p-8 text-center border border-white/80 shadow-[6px_6px_14px_#c2c9d4,-6px_-6px_14px_#ffffff]">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#e6ebf2] shadow-[inset_2px_2px_5px_#c2c9d4,inset_-2px_-2px_5px_#ffffff] flex items-center justify-center text-emerald-600 font-mono text-2xl font-bold">
        404
      </div>
      <h1 class="text-xl font-extrabold text-zinc-900 mb-2">Page Not Found</h1>
      <p class="text-sm text-zinc-500 mb-6">The requested clinical view does not exist or has been moved.</p>
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-emerald-600 to-emerald-700 shadow-[3px_3px_8px_#c5ccd6,-3px_-3px_8px_#ffffff] hover:from-emerald-500 hover:to-emerald-600 active:scale-95 transition-all"
      >
        Return to Clinical Console
      </a>
    </div>
  </body>
</html>
