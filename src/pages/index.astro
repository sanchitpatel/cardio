---
import "../styles/dashboard.css";
import DashboardApp from "../components/dashboard/DashboardApp.jsx";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/avif" sizes="any" href="/logo.avif" />
    <link rel="icon" type="image/avif" sizes="512x512" href="/logo.avif" />
    <link rel="icon" type="image/avif" sizes="192x192" href="/logo.avif" />
    <link rel="shortcut icon" href="/logo.avif" />
    <link rel="apple-touch-icon" href="/logo.avif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>dHealth Cardio — Clinical Management Console</title>
    <meta name="description" content="Secure cardiac clinical management portal for patient tracking, follow-ups, and daily queues." />

    <!-- Open Graph Meta Tags (WhatsApp, Telegram, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dHealth Cardio" />
    <meta property="og:title" content="dHealth Cardio — Clinical Management Console" />
    <meta property="og:description" content="Secure cardiac clinical management portal for patient tracking, follow-ups, and daily queues." />
    <meta property="og:url" content="https://dhealth-cardio.vercel.app/" />
    <meta property="og:image" content="https://dhealth-cardio.vercel.app/og-image.png" />
    <meta property="og:image:secure_url" content="https://dhealth-cardio.vercel.app/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dHealth Cardio Clinical Console" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="dHealth Cardio — Clinical Management Console" />
    <meta name="twitter:description" content="Secure cardiac clinical management portal for patient tracking, follow-ups, and daily queues." />
    <meta name="twitter:image" content="https://dhealth-cardio.vercel.app/og-image.png" />
    
    <!-- PWA & Mobile Web App Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#e6ebf2" />
    <meta name="msapplication-navbutton-color" content="#e6ebf2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cardio Console" />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- PWA Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function(err) {
            console.warn('PWA registration skipped:', err);
          });
        });
      }
    </script>
  </head>
  <body class="bg-[#e6ebf2] text-zinc-900 antialiased selection:bg-emerald-500/20 selection:text-emerald-900 h-screen overflow-hidden">
    <DashboardApp client:load />
  </body>
</html>